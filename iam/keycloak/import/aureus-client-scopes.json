[
  {
    "id": "aurix-cpf",
    "name": "aurix-cpf",
    "description": "CPF do usuário no sistema AUREUS",
    "protocol": "openid-connect",
    "attributes": {
      "include.in.token.scope": "true",
      "display.on.consent.screen": "true",
      "consent.screen.text": "Acesso ao CPF do usuário"
    },
    "protocolMappers": [
      {
        "id": "cpf-mapper",
        "name": "CPF Mapper",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-usermodel-attribute-mapper",
        "consentRequired": false,
        "config": {
          "userinfo.token.claim": "true",
          "user.attribute": "cpf",
          "id.token.claim": "true",
          "access.token.claim": "true",
          "claim.name": "cpf",
          "jsonType.label": "String"
        }
      }
    ]
  },
