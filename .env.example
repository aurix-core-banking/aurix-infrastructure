# =============================================================================
# AUREUS Platform — Infrastructure environment variables
# =============================================================================
# Copie este arquivo para .env e ajuste os valores para seu ambiente.
# NUNCA commite o arquivo .env com valores reais.
#
# Uso:
#   cp .env.example .env
#   # edite .env com seus valores reais
#   docker compose up
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL — Banco de dados relacional principal
# -----------------------------------------------------------------------------

# Nome do banco de dados principal. Consumido por: postgres, todos os serviços aurix-*.
POSTGRES_DB=replace_with_db_name

# Usuário administrador do PostgreSQL. Consumido por: postgres, todos os serviços aurix-*.
POSTGRES_USER=replace_with_db_user

# Senha do usuário administrador do PostgreSQL. Consumido por: postgres, todos os serviços aurix-*.
POSTGRES_PASSWORD=replace_with_secure_password

# -----------------------------------------------------------------------------
# Grafana — Dashboards e visualização de métricas
# -----------------------------------------------------------------------------

# Senha do usuário admin da interface web do Grafana. Consumido por: grafana.
GRAFANA_ADMIN_PASSWORD=replace_with_secure_password

# -----------------------------------------------------------------------------
# MinIO — Object storage (S3-compatible)
# -----------------------------------------------------------------------------

# Usuário root (equivalente ao Access Key) do MinIO. Consumido por: minio.
MINIO_ROOT_USER=replace_with_minio_user

# Senha root (equivalente ao Secret Key) do MinIO. Consumido por: minio.
MINIO_ROOT_PASSWORD=replace_with_secure_password

# -----------------------------------------------------------------------------
# Keycloak — Identity and Access Management (IAM)
# -----------------------------------------------------------------------------

# Usuário administrador da console do Keycloak. Consumido por: keycloak.
KEYCLOAK_ADMIN=replace_with_admin_user

# Senha do usuário administrador da console do Keycloak. Consumido por: keycloak.
KEYCLOAK_ADMIN_PASSWORD=replace_with_secure_password

# Usuário do banco de dados PostgreSQL usado pelo Keycloak para persistência. Consumido por: keycloak.
KEYCLOAK_DB_USERNAME=replace_with_keycloak_db_user

# Senha do banco de dados PostgreSQL usado pelo Keycloak para persistência. Consumido por: keycloak.
KEYCLOAK_DB_PASSWORD=replace_with_secure_password

# -----------------------------------------------------------------------------
# ClickHouse — Banco de dados OLAP para analytics
# -----------------------------------------------------------------------------

# Usuário de acesso ao ClickHouse. Consumido por: clickhouse, aurix-data-pipelines/sync.
CLICKHOUSE_USER=replace_with_clickhouse_user

# Senha do usuário ClickHouse. Consumido por: clickhouse, aurix-data-pipelines/sync.
CLICKHOUSE_PASSWORD=replace_with_secure_password

# -----------------------------------------------------------------------------
# TimescaleDB — Banco de dados de séries temporais
# -----------------------------------------------------------------------------

# Nome do banco de dados TimescaleDB. Consumido por: timescaledb, aurix-data-pipelines/airflow.
TIMESCALEDB_DB=replace_with_timeseries_db_name

# Usuário do TimescaleDB. Consumido por: timescaledb, aurix-data-pipelines/airflow.
TIMESCALEDB_USER=replace_with_timeseries_user

# Senha do usuário TimescaleDB. Consumido por: timescaledb, aurix-data-pipelines/airflow.
TIMESCALEDB_PASSWORD=replace_with_secure_password

# -----------------------------------------------------------------------------
# Spring Services — Credenciais compartilhadas para todos os microsserviços Java
# -----------------------------------------------------------------------------

# Usuário do datasource Spring (PostgreSQL). Consumido por: todos os serviços aurix-* (Spring Boot).
SPRING_DATASOURCE_USERNAME=replace_with_datasource_user

# Senha do datasource Spring (PostgreSQL). Consumido por: todos os serviços aurix-* (Spring Boot).
SPRING_DATASOURCE_PASSWORD=replace_with_secure_password

# -----------------------------------------------------------------------------
# JWT — JSON Web Token signing secret
# -----------------------------------------------------------------------------

# Chave secreta para assinatura de tokens JWT. Consumido por: aurix-gateway, svc-customer.
# Use um valor com no mínimo 256 bits de entropia (ex.: openssl rand -base64 32).
AURIX_JWT_SECRET=replace_with_random_256bit_secret

# -----------------------------------------------------------------------------
# svc-payments — URL base do SPI (Sistema de Pagamentos Instantâneos)
# -----------------------------------------------------------------------------

# URL base do SPI/BACEN mock para PIX. Consumido por: svc-payments.
# No docker-compose, aponte para o container bacen-mock (http://bacen-mock:8095).
AURIX_PAYMENTS_SPI_URL=http://bacen-mock:8095
