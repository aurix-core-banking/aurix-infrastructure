{
  "dashboard": {
    "id": null,
    "title": "Aurix - PIX (svc-payments)",
    "tags": ["aurix", "pix", "payments"],
    "style": "dark",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Status do serviço",
        "type": "stat",
        "targets": [
          {
            "expr": "up{job=\"svc-payments\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "red", "value": 0 },
                { "color": "green", "value": 1 }
              ]
            }
          }
        },
        "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 }
      },
      {
        "id": 2,
        "title": "Taxa de requisições PIX (req/s)",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count{job=\"svc-payments\", uri=~\"/api/pix/.*\"}[5m]))",
            "refId": "A"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }
      },
      {
        "id": 3,
        "title": "Latência P95 (s)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"svc-payments\", uri=~\"/api/pix/.*\"}[5m])))",
            "refId": "A"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }
      },
      {
        "id": 4,
        "title": "Taxa de erros 5xx (req/s)",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count{job=\"svc-payments\", status=~\"5..\", uri=~\"/api/pix/.*\"}[5m]))",
            "refId": "A"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 }
      },
      {
        "id": 5,
        "title": "PIX por hora",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count{job=\"svc-payments\", uri=~\"/api/pix/.*\"}[1m])) * 60",
            "refId": "A"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 }
      }
    ],
    "schemaVersion": 39,
    "version": 1
  }
}
